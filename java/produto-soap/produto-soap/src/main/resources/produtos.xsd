<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://cps.sp.gov.br/produtos"
           xmlns:tns="http://cps.sp.gov.br/produtos"
           elementFormDefault="qualified">

    <!-- Requisição de Consulta de Produto -->
    <xs:element name="consultarProdutoRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="nome" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Resposta da Consulta de Produto -->
    <xs:element name="consultarProdutoResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="nome" type="xs:string"/>
                <xs:element name="descricao" type="xs:string"/>
                <xs:element name="marca" type="xs:string"/>
                <xs:element name="quantidadeEstoque" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>